<Window x:Class="Easytorier.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Easytorier — Welcome" Height="680" Width="1080"
        MinHeight="600" MinWidth="900" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDark}" Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="4,0,4,20">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource AccentBlue}" Margin="0,0,12,0">
                    <TextBlock Text="E" FontSize="26" FontWeight="Black" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="EASYTORIER" FontSize="20" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="VECTOR LEVEL STUDIO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="1,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="v1.0 · READY" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="Bold"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="36" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left">
                        <Border Background="{DynamicResource BgHeader}" CornerRadius="12" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,18">
                            <TextBlock Text="YOUR LEVEL. YOUR RULES." Foreground="{DynamicResource AccentBlue}" FontWeight="Bold" FontSize="11"/>
                        </Border>
                        <TextBlock Text="Build something&#10;worth running." FontSize="44" FontWeight="Black" LineHeight="52" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                        <TextBlock Text="Design Vector-style parkour levels, arrange texture prefabs, animate objects, and compile your work for Vectorier." FontSize="15" LineHeight="23" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,18,0,0" MaxWidth="510"/>
                    </StackPanel>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,26,0,0">
                        <Border Background="{DynamicResource BgHeader}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="01" Foreground="{DynamicResource AccentBlue}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Build" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="Place and shape your level" Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BgHeader}" CornerRadius="8" Padding="12" Margin="4,0">
                            <StackPanel><TextBlock Text="02" Foreground="{DynamicResource AccentBlue}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Animate" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="Bring objects to life" Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BgHeader}" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                            <StackPanel><TextBlock Text="03" Foreground="{DynamicResource AccentBlue}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Export" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="Compile to Vectorier XML" Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel>
                    <TextBlock Text="Jump back in" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Choose where you want to go." Foreground="{DynamicResource TextMuted}" Margin="0,4,0,18"/>
                    <Button Content="▶   Start Level Editor" Style="{DynamicResource PrimaryButton}" Height="48" Margin="0,0,0,10" Click="OnStartEditorClick"/>
                    <Button Content="▦   Project Manager" Style="{DynamicResource DarkButton}" Height="42" Margin="0,0,0,18" Click="OnOpenProjectsClick"/>
                    <Separator Background="{DynamicResource BorderDark}" Margin="0,0,0,14"/>
                    <TextBlock Text="MORE TOOLS" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="2,0,0,8"/>
                    <Button Content="🎨   Theme Editor" Style="{DynamicResource DarkButton}" Height="38" Margin="0,0,0,7" Click="OnOpenSettingsClick"/>
                    <Button Content="🎮   Arcade Rules" Style="{DynamicResource DarkButton}" Height="38" Margin="0,0,0,7" Click="OnOpenMinigameClick"/>
                    <Button Content="✦   Credits" Style="{DynamicResource DarkButton}" Height="38" Click="OnOpenCreditsClick"/>
                    <TextBlock Text="Tip: use the Project Manager to keep each level in its own workspace." Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="2,20,2,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="4,16,4,0">
            <TextBlock Text="Easytorier Level Studio" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
            <Button Content="Exit" DockPanel.Dock="Right" Style="{DynamicResource DarkButton}" Padding="14,6" Click="OnCloseClick"/>
            <TextBlock Text=".NET WPF · Local project files" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,16,0"/>
        </DockPanel>
    </Grid>
</Window>
