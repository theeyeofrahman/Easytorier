<Window x:Class="Easytorier.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme Editor" Width="900" Height="720" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgDark}" Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Make Easytorier yours" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="Pick a starting palette, tune every surface and accent, then save or share your theme."
                       Margin="0,5,0,8" Foreground="{DynamicResource TextMuted}" FontSize="13"/>
            <DockPanel>
                <TextBlock Text="Theme name" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ThemeNameBox" Text="Deep Slate" Padding="6" Width="220" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}"/>
            </DockPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderDark}"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="START WITH A PALETTE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
                <WrapPanel x:Name="PresetPanel"/>
                <TextBlock x:Name="LibraryLabel" Text="MY SAVED THEMES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,12,0,7" Visibility="Collapsed"/>
                <WrapPanel x:Name="LibraryPanel"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderDark}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="COLOR TOKENS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBlock Text="Enter #RRGGBB or #AARRGGBB. Valid colors preview instantly."
                                   Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,12"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,10"><TextBlock Text="Window background" Foreground="{DynamicResource TextPrimary}"/><TextBox x:Name="BgDarkBox" TextChanged="OnColorChanged" Padding="7" Margin="0,4,0,0" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}"/></StackPanel>
                            <StackPanel Margin="10,0,0,10"><TextBlock Text="Panel surface" Foreground="{DynamicResource TextPrimary}"/><TextBox x:Name="BgPanelBox" TextChanged="OnColorChanged" Padding="7" Margin="0,4,0,0" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}"/></StackPanel>
                            <StackPanel Margin="0,0,10,10"><TextBlock Text="Header surface" Foreground="{DynamicResource TextPrimary}"/><TextBox x:Name="BgHeaderBox" TextChanged="OnColorChanged" Padding="7" Margin="0,4,0,0" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}"/></StackPanel>
                            <StackPanel Margin="10,0,0,10"><TextBlock Text="Canvas background" Foreground="{DynamicResource TextPrimary}"/><TextBox x:Name="BgCanvasBox" TextChanged="OnColorChanged" Padding="7" Margin="0,4,0,0" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}"/></StackPanel>
                            <StackPanel Margin="0,0,10,10"><TextBlock Text="Input background" Foreground="{DynamicResource TextPrimary}"/><TextBox x:Name="BgInputBox" TextChanged="OnColorChanged" Padding="7" Margin="0,4,0,0" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}"/></StackPanel>
                            <StackPanel Margin="10,0,0,10"><TextBlock Text="Borders and dividers" Foreground="{DynamicResource TextPrimary}"/><TextBox x:Name="BorderDarkBox" TextChanged="OnColorChanged" Padding="7" Margin="0,4,0,0" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}"/></StackPanel>
                            <StackPanel Margin="0,0,10,10"><TextBlock Text="Main text" Foreground="{DynamicResource TextPrimary}"/><TextBox x:Name="TextPrimaryBox" TextChanged="OnColorChanged" Padding="7" Margin="0,4,0,0" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}"/></StackPanel>
                            <StackPanel Margin="10,0,0,10"><TextBlock Text="Muted text" Foreground="{DynamicResource TextPrimary}"/><TextBox x:Name="TextMutedBox" TextChanged="OnColorChanged" Padding="7" Margin="0,4,0,0" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}"/></StackPanel>
                            <StackPanel Margin="0,0,10,10"><TextBlock Text="Accent color" Foreground="{DynamicResource TextPrimary}"/><TextBox x:Name="AccentBlueBox" TextChanged="OnColorChanged" Padding="7" Margin="0,4,0,0" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}"/></StackPanel>
                            <StackPanel Margin="10,0,0,10"><TextBlock Text="Text on accent" Foreground="{DynamicResource TextPrimary}"/><TextBox x:Name="AccentTextBox" TextChanged="OnColorChanged" Padding="7" Margin="0,4,0,0" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}"/></StackPanel>
                            <StackPanel Margin="0,0,10,10"><TextBlock Text="Grid tile" Foreground="{DynamicResource TextPrimary}"/><TextBox x:Name="GridBaseBox" TextChanged="OnColorChanged" Padding="7" Margin="0,4,0,0" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}"/></StackPanel>
                            <StackPanel Margin="10,0,0,10"><TextBlock Text="Grid lines" Foreground="{DynamicResource TextPrimary}"/><TextBox x:Name="GridLineBox" TextChanged="OnColorChanged" Padding="7" Margin="0,4,0,0" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}"/></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Column="2">
                <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="LIVE PREVIEW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>
                        <Border Background="{DynamicResource BgHeader}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Inspector panel" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="A preview of your colors in the editor." TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,10"/>
                                <TextBox Text="Editable field" Padding="7" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderDark}" Margin="0,0,0,8"/>
                                <Button Content="Accent action" Style="{StaticResource PrimaryButton}" Padding="9" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BgCanvas}" BorderBrush="{DynamicResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Canvas colors" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                <Grid Height="54">
                                    <Grid.Background>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,18,18" ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing><DrawingGroup>
                                                <GeometryDrawing Brush="{DynamicResource GridBase}" Geometry="M0,0 H18 V18 H0 Z"/>
                                                <GeometryDrawing Brush="{DynamicResource GridLine}"><GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="0,17.5" EndPoint="18,17.5"/><LineGeometry StartPoint="17.5,0" EndPoint="17.5,18"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                                            </DrawingGroup></DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Grid.Background>
                                    <Border Width="60" Height="20" Background="{DynamicResource AccentBlue}" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ValidationText" Text="Preview is live" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="StatusLabel" Text="Changes apply instantly. Save to remember this theme next time."
                   Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="2,12,0,12"/>
        <DockPanel Grid.Row="4">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Import…" Style="{StaticResource DarkButton}" Padding="12,8" Margin="0,0,7,0" Click="OnImport"/>
                <Button Content="Export…" Style="{StaticResource DarkButton}" Padding="12,8" Margin="0,0,7,0" Click="OnExport"/>
                <Button Content="Reset" Style="{StaticResource DarkButton}" Padding="12,8" Click="OnReset"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save theme" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,7,0" Click="OnSave"/>
                <Button Content="Done" Style="{StaticResource DarkButton}" Padding="16,8" IsDefault="True" Click="OnDone"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>