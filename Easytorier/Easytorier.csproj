<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\VectorTextures\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\VectorTextures\**\*.jpg" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\VectorTextures\**\*.jpeg" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\TriggerTemplates.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
