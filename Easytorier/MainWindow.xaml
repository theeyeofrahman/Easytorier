<Window x:Class="Easytorier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Easytorier Level Editor" Height="768" Width="1366"
        Background="{StaticResource BgDark}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Menu Bar -->
            <RowDefinition Height="30"/>
            <!-- Top Action Bar -->
            <RowDefinition Height="40"/>
            <!-- Main Workspace -->
            <RowDefinition Height="*"/>
            <!-- Status & Timeline Bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- MENU BAR -->
        <Menu Grid.Row="0" Background="{StaticResource BgHeader}" Foreground="{StaticResource TextPrimary}" Padding="4,2">
            <MenuItem Header="EASYTORIER" Foreground="{StaticResource AccentBlue}" FontWeight="Bold"/>
            <MenuItem Header="File">
                <MenuItem Header="New Level"/>
                <MenuItem Header="Open XML..."/>
                <MenuItem Header="Save XML"/>
            </MenuItem>
            <MenuItem Header="Edit"/>
            <MenuItem Header="View"/>
            <MenuItem Header="Level"/>
            <MenuItem Header="Settings">
                <MenuItem Header="Theme Manager..." Click="OnOpenThemeManager"/>
            </MenuItem>
        </Menu>

        <!-- TOP ACTION / TOOLBAR -->
        <Border Grid.Row="1" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="10,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Select" Style="{StaticResource DarkButton}" Margin="0,0,6,0" Click="OnSelectToolClick"/>
                    <Button Content="Wall" Style="{StaticResource DarkButton}" Margin="0,0,6,0" Click="OnWallToolClick"/>
                    <Button Content="Obstacle" Style="{StaticResource DarkButton}" Margin="0,0,6,0" Click="OnObstacleToolClick"/>
                    <Button Content="Trigger" Style="{StaticResource DarkButton}" Margin="0,0,16,0" Click="OnTriggerToolClick"/>
                </StackPanel>
                <Button Content="▶ Test in Vector" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6"/>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" MaxWidth="400"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="320" MinWidth="240" MaxWidth="450"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Objects & Tools -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="SCENE OBJECTS" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,12"/>
                    <Button Content="+ Platform" Style="{StaticResource DarkButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                    <Button Content="+ Obstacle" Style="{StaticResource DarkButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                    <Button Content="+ Spawn Point" Style="{StaticResource DarkButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                    <Button Content="+ Rail / Zip" Style="{StaticResource DarkButton}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Left Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderDark}" Cursor="SizeWE" ResizeDirection="Columns" ShowsPreview="True"/>

            <!-- Center Viewport Canvas -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#141414">
                <Canvas x:Name="LevelViewport" Width="4000" Height="2000" Background="#181818">
                    <!-- Level items render dynamically here -->
                </Canvas>
            </ScrollViewer>

            <!-- Right Splitter -->
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderDark}" Cursor="SizeWE" ResizeDirection="Columns" ShowsPreview="True"/>

            <!-- Right Panel: Hierarchy, Properties & Hybrid AI Co-pilot -->
            <Border Grid.Column="4" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1,0,0,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Hierarchy Tree Top -->
                        <RowDefinition Height="130"/>
                        <RowDefinition Height="Auto"/>
                        <!-- Properties Section -->
                        <RowDefinition Height="130"/>
                        <RowDefinition Height="Auto"/>
                        <!-- Hybrid AI Co-pilot Section -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Hierarchy Tree -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="HIERARCHY" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="8" Height="90">
                            <TreeView Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource TextPrimary}">
                                <TreeViewItem Header="World" IsExpanded="True">
                                    <TreeViewItem Header="Player Start"/>
                                    <TreeViewItem Header="Hunter Start"/>
                                    <TreeViewItem Header="Roof_Building_01"/>
                                </TreeViewItem>
                            </TreeView>
                        </Border>
                    </StackPanel>

                    <Separator Grid.Row="1" Background="{StaticResource BorderDark}" Margin="0,8"/>

                    <!-- Properties Section -->
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="PROPERTIES" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,4,4">
                                <TextBlock Text="Position X" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox Background="#333337" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" Padding="4" Text="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="4,0,0,4">
                                <TextBlock Text="Position Y" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox Background="#333337" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" Padding="4" Text="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,4,4,0">
                                <TextBlock Text="Rotation" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox Background="#333337" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" Padding="4" Text="0°"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Separator Grid.Row="3" Background="{StaticResource BorderDark}" Margin="0,8"/>

                    <!-- Hybrid AI Co-pilot Section -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="AI CO-PILOT" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>

                        <!-- Chat Output Log -->
                        <ListBox x:Name="AiChatLog" Grid.Row="1" Background="#181818" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,6" Padding="6">
                            <ListBoxItem Content="Co-pilot initialized. Type a prompt to generate level structures." Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        </ListBox>

                        <!-- Input & Trigger Action -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AiInputBox" Grid.Column="0" Background="#333337" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="6" VerticalContentAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                            <Button Grid.Column="1" Content="Send" Style="{StaticResource PrimaryButton}" Padding="10,4" Click="OnSendAiPrompt"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="00:00.00" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="100% | Snap: 16px" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>