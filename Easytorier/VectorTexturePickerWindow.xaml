<Window x:Class="Easytorier.VectorTexturePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vector Texture Packs" Width="850" Height="620" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#FF202329" Foreground="#FFF1F2F4">
    <Grid Margin="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Browse all textures from track_content_2048 by their filename variant pack."
                           TextWrapping="Wrap" Foreground="#FFBFC5CE" Margin="0,0,0,8"/>
                <ComboBox x:Name="PackFilterBox" SelectionChanged="OnPackFilterChanged" Margin="0,0,0,10"
                          Background="#FF292D34" Foreground="#FFF1F2F4" BorderBrush="#FF414751"/>
            </StackPanel>
            <ListBox x:Name="TextureList" Background="#FF292D34" Foreground="#FFF1F2F4" BorderBrush="#FF414751"
                     SelectionChanged="OnTextureSelected" MouseDoubleClick="OnTextureDoubleClick">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="154" Height="144" Margin="4" Padding="6" Background="#FF202329" BorderBrush="#FF414751" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <Border Height="86" Background="#FF17191D" Padding="4">
                                    <Image Source="{Binding Preview}" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="{Binding DisplayName}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding PackName}" FontSize="8" Foreground="#FF9EA7B3" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <Border Grid.Column="2" Background="#FF292D34" BorderBrush="#FF414751" BorderThickness="1" CornerRadius="5" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="#FF17191D" Padding="8" Margin="0,0,0,10">
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                </Border>
                <TextBlock Grid.Row="1" x:Name="NameLabel" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="2" x:Name="SizeLabel" Foreground="#FFBFC5CE" Margin="0,0,0,10"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Padding="12,6" Margin="0,0,7,0"/>
                    <Button Content="Use texture" IsDefault="True" Click="OnUseTexture" Padding="12,6" Background="#FF2787D8" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>